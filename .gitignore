# Local-only tooling configs / scratch (not part of the public site)
.claude/

# OS junk
.DS_Store
Thumbs.db

# Editor / IDE
.idea/
.vscode/
*.swp

# Supabase CLI scratch
supabase/.temp/

# Python virtualenv / caches (for /scripts utilities)
__pycache__/
*.pyc
.venv/
venv/

# WhatsApp auto-poster — local "already posted" ledger (synced via Drive,
# not committed, so the daily GitHub Actions build never collides with it).
# The Playwright browser profile lives outside the repo (~/.deputations-wa).
data/whatsapp_posted.json

# Session archives — full chat transcripts saved locally for continuity / handoff
# across machines (Drive-synced). MUST NOT be published: the repo is public and
# these contain internal Supabase/project details.
session-archive_*/
_archive_chat.py

# VAPID push private key — NEVER commit (set as a Supabase secret instead)
supabase/.vapid.keys
*.vapid.keys

# Astro build artifacts (regenerated on every workflow run; never committed)
astro/dist/
astro/public/
astro/node_modules/
astro/.astro/

# Per-vacancy OG images (P2-4). ~14 MB total, regenerated on every cron
# run by scripts/build_og_images.py. Astro workflow mirrors them into
# the build, so committing them to git would just bloat history with
# binary diffs every day. Same for any other build-time generated
# assets.
og/
og-*.png
og-*

---
// contact.astro — port of contact.html.
//
// Body content is inlined from the static HTML file via InlinePageBody,
// so edits to contact.html propagate to the Astro build via a simple
// `npm run build`. Page-specific CSS (contact.css) and JS (contact.js)
// are loaded via Layout's slot system.

import Layout from "../layouts/Layout.astro";
import InlinePageBody from "../components/InlinePageBody.astro";
---

<Layout
  title="Contact & Community | Deputations"
  description="Join the Deputations WhatsApp Channel for vacancy alerts and Employment News, the Group for deputation discussions, or send the site team direct feedback."
  pageClass=""
>
  <Fragment slot="head">
    <!-- This page uses Unbounded only (no Inter/Sora) -->
    <link
      href="https://fonts.googleapis.com/css2?family=Unbounded:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/contact.css?v=6" />
  </Fragment>

  <InlinePageBody src="../contact.html" />

  <Fragment slot="scripts">
    <script is:inline src="/contact.js?v=sb6"></script>
    <script is:inline defer src="/site-widgets.js?v=23"></script>
  </Fragment>
</Layout>
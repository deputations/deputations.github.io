---
// 404.astro — fallback page that ALSO acts as a redirector.
//
// GitHub Pages can't automatically rewrite /contact.html to /contact/.
// This 404 catches the legacy URL shape and redirects to the directory
// form that the Astro build emits. Without this, every nav link would
// 404 on the GH Pages side.
//
// It uses a meta-refresh (works without JS) plus a tiny <script> for
// immediate redirect (faster). Both update the visible URL to the
// directory form so the browser back-button works.
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title>Redirecting…</title>
    <script is:inline>
      (function () {
        var path = location.pathname.replace(/\.html$/, "/").replace(/\/+/g, "/");
        // don't redirect the root
        if (path !== location.pathname) {
          location.replace(path + location.search + location.hash);
        }
      })();
    </script>
    <meta http-equiv="refresh" content="0; url=/index.html">
    <link rel="canonical" href="/index.html">
  </head>
  <body>
    <p>Redirecting…</p>
  </body>
</html>
---
// Navbar.astro — shared top nav.
//
// Currently rendered in 7 HTML files with hand-rolled <a> tags. This
// component makes future changes (link re-ordering, adding pages) a
// single-file edit. For checkpoint A only index.astro uses it; P2-2 will
// replace the inline nav in defex.html / contact.html / etc.

const path = Astro.url.pathname.replace(/\/$/, "");
function active(href: string): string {
  if (href === "/" && path === "") return "active";
  if (href === "/" && path === "/") return "active";
  // match if path equals href exactly OR href is a prefix segment
  if (href !== "/" && (path === href.replace(/\/$/, "") || path.startsWith(href))) return "active";
  return "";
}
const links = [
  { href: "/",         label: "Home",            match: "/" },
  { href: "/rules/",   label: "Rules",           match: "/rules/" },
  { href: "/faq/",     label: "FAQs",            match: "/faq/" },
  { href: "/defex/",   label: "DeFeX",           match: "/defex/" },
  { href: "/report-vacancy/", label: "Report Vacancy", match: "/report-vacancy/" },
  { href: "/contact/", label: "Contact",         match: "/contact/" },
  { href: "/my-deputation/", label: "My Deputation", match: "/my-deputation/" },
];
---

<nav class="top-nav" aria-label="Primary site navigation">
  <a class="nav-brand" href="/" aria-label="Deputations — home">
    <svg class="nav-brand-mark" viewBox="0 0 32 32" aria-hidden="true">
      <defs>
        <linearGradient id="nbGrad" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#22d3ee" />
          <stop offset="1" stop-color="#a78bfa" />
        </linearGradient>
      </defs>
      <rect width="32" height="32" rx="9" fill="url(#nbGrad)" />
      <path d="M12 9.5h4.4a6.5 6.5 0 0 1 0 13H12z" fill="none" stroke="#04111c" stroke-width="2.6" stroke-linejoin="round" />
    </svg>
    <span class="nav-brand-name">Deputations</span>
  </a>
  <div class="nav-links">
    {links.map((l) => (
      <a href={l.href} class={active(l.match)}>{l.label}</a>
    ))}
  </div>
</nav>

---
// IconSprite.astro — inline SVG <defs> block with every icon symbol used
// across the site. Rendered once at the top of every page that needs
// icons (currently every page). Pages reference icons via
// `<use href="#i-heart"/>` etc.
//
// This currently lives at the top of every static HTML file as a 30-line
// block. With this component, the symbol list lives in one place.

const symbols = [
  { id: "i-heart",        viewBox: "0 0 24 24", children: `<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"/>` },
  { id: "i-moon",         viewBox: "0 0 24 24", children: `<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>` },
  { id: "i-sun",          viewBox: "0 0 24 24", children: `<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>` },
  { id: "i-filter",       viewBox: "0 0 24 24", children: `<path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/>` },
  { id: "i-search",       viewBox: "0 0 24 24", children: `<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>` },
  { id: "i-sliders",      viewBox: "0 0 24 24", children: `<path d="M21 4h-7M10 4H3M21 12h-9M8 12H3M21 20h-5M12 20H3M14 2v4M8 10v4M16 18v4"/>` },
  { id: "i-chevron-down", viewBox: "0 0 24 24", children: `<path d="m6 9 6 6 6-6"/>` },
  { id: "i-table",        viewBox: "0 0 24 24", children: `<path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/>` },
  { id: "i-grid",         viewBox: "0 0 24 24", children: `<rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/>` },
  { id: "i-x",            viewBox: "0 0 24 24", children: `<path d="M18 6 6 18M6 6l12 12"/>` },
  { id: "i-flag",         viewBox: "0 0 24 24", children: `<path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><path d="M4 22v-7"/>` },
  { id: "i-thumbs-up",    viewBox: "0 0 24 24", children: `<path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/>` },
  { id: "i-briefcase",    viewBox: "0 0 24 24", children: `<rect width="20" height="14" x="2" y="6" rx="2"/><path d="M16 6V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>` },
  { id: "i-check-circle", viewBox: "0 0 24 24", children: `<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/>` },
  { id: "i-clock",        viewBox: "0 0 24 24", children: `<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>` },
  { id: "i-building",     viewBox: "0 0 24 24", children: `<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4M10 10h4M10 14h4M10 18h4"/>` },
  { id: "i-map-pin",      viewBox: "0 0 24 24", children: `<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>` },
  { id: "i-share",        viewBox: "0 0 24 24", children: `<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.59 13.51 6.83 3.98M15.41 6.51l-6.82 3.98"/>` },
  { id: "i-link",         viewBox: "0 0 24 24", children: `<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>` },
  { id: "i-external",     viewBox: "0 0 24 24", children: `<path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>` },
  { id: "i-layers",       viewBox: "0 0 24 24", children: `<path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>` },
  { id: "i-calendar",     viewBox: "0 0 24 24", children: `<path d="M8 2v4M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>` },
  { id: "i-bookmark",     viewBox: "0 0 24 24", children: `<path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/>` },
  { id: "i-landmark",     viewBox: "0 0 24 24", children: `<path d="M3 22h18"/><path d="M6 18v-7M10 18v-7M14 18v-7M18 18v-7"/><path d="m12 2 8 5H4l8-5Z"/>` },
  { id: "i-whatsapp",     viewBox: "0 0 24 24", children: `<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>` },
];
---

<svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
  <defs>
    {symbols.map((s) => (
      <symbol id={s.id} viewBox={s.viewBox}>
        <Fragment set:html={s.children} />
      </symbol>
    ))}
  </defs>
</svg>
